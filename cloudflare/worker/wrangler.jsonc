{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexapc-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "AlexaPcRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AlexaPcRelay"]
    }
  ]
}
