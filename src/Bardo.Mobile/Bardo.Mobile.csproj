<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.treska23.bardo</ApplicationId>
    <ApplicationTitle>Bardo</ApplicationTitle>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.3</ApplicationDisplayVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- The APK is installed manually with adb on the dedicated OPPO. Embed
         managed assemblies so the package is self-contained and does not rely
         on Visual Studio/.NET Android Fast Deployment override files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
</Project>
