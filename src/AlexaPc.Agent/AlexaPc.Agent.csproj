<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlexaPc</AssemblyName>
    <RootNamespace>AlexaPc.Agent</RootNamespace>
    <ApplicationIcon>Assets\AlexaPc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AlexaPc.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlexaPc.Control\AlexaPc.Control.csproj" />
    <ProjectReference Include="..\AlexaPc.Relay\AlexaPc.Relay.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLocalRelay" AfterTargets="Build">
    <ItemGroup>
      <LocalRelayFiles Include="..\AlexaPc.Relay\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(LocalRelayFiles)"
      DestinationFiles="@(LocalRelayFiles->'$(OutDir)Relay\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
