    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlexaPc</AssemblyName>
    <RootNamespace>AlexaPc.Agent</RootNamespace>
    <ApplicationIcon>Assets\AlexaPc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AlexaPc.ico" />
  </ItemGroup>
</Project>
