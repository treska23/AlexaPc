<Window x:Class="AlexaPc.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlexaPc"
        Width="900"
        Height="620"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="AlexaPc" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Agente local de control de Windows" Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="LOCAL" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Comandos" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Selecciona uno para probar exactamente lo que ejecutará Alexa." Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Abrir commands.json" Command="{Binding OpenConfigurationCommand}" />
                        <Button Content="Recargar" Command="{Binding ReloadCommand}" Margin="0" />
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding Commands}"
                          SelectedItem="{Binding SelectedCommand}"
                          Background="#151515"
                          Foreground="{StaticResource TextBrush}"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nombre" Width="210" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Tipo" Width="110" DisplayMemberBinding="{Binding Type}" />
                            <GridViewColumn Header="Descripción" Width="390" DisplayMemberBinding="{Binding Description}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" />
                <TextBlock Text="{Binding ConfigurationPath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Ejecutar comando"
                    Command="{Binding ExecuteSelectedCommand}"
                    Padding="20,10"
                    Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>
